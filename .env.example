# Supabase — proyecto en supabase.com → Project Settings → API
# VITE_SUPABASE_ANON_KEY es la "publishable key" (segura de exponer en el
# navegador). La "secret key" (service_role) NUNCA va aquí ni con prefijo
# VITE_ — solo se usa en scripts server-side (ver scripts/setup-admin.mjs).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase (en proceso de migración a Supabase — ver supabase/migrations/)
# copia estas variables en Netlify → Site Settings → Environment Variables
# Renombra de FIREBASE_* a VITE_FIREBASE_* (Vite expone solo variables con prefijo VITE_)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — subida de imágenes sin necesidad de plan pago en Firebase Storage
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# EmailJS (opcional — si no configuras, los emails se omiten silenciosamente)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Google Maps — habilitar en Google Cloud: Maps JavaScript API + Places API
VITE_GOOGLE_MAPS_API_KEY=

# App Check (anti-bot) — clave de sitio de reCAPTCHA v3. Ver SECURITY.md para
# el paso a paso de activación. Opcional: sin esta variable la app funciona
# igual, solo sin esta protección extra contra scripts automatizados.
VITE_RECAPTCHA_SITE_KEY=

# Sentry (monitoreo de errores) — DSN de tu proyecto en sentry.io. Opcional:
# sin esta variable la app funciona igual, solo sin reportar errores.
VITE_SENTRY_DSN=
